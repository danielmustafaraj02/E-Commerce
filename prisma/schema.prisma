// Prisma schema for the white-label e-commerce platform.
//
// Postgres (connection URL lives in prisma.config.ts + DATABASE_URL in .env
// — Prisma 7 no longer accepts `url` inside the datasource block).
// Money is always stored as an Int in minor currency units (cents), matching
// how Stripe represents amounts, to avoid floating point rounding bugs.
//
// Role/status fields are plain strings (not Prisma enums) validated with zod
// at the application boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// White-label configuration — the single table that rebrands the whole store.
// ---------------------------------------------------------------------------

model StoreSettings {
  id                     String   @id @default(cuid())
  storeName              String   @default("My Store")
  logoUrl                String?
  primaryColor           String   @default("#111827")
  secondaryColor         String   @default("#4F46E5")
  fontFamily             String   @default("Inter")
  defaultCurrency        String   @default("EUR")
  defaultLocale          String   @default("en-US")
  contactEmail           String   @default("hello@example.com")
  vatNumber              String?
  companyLegalName       String?
  companyAddress         String?
  pricesIncludeTax       Boolean  @default(true)
  freeShippingThreshold  Int? // cents; null = disabled
  // Short authenticity/trust line shown as a badge on product pages, near
  // the price — e.g. "100% authentic, handmade in Murano." Free text (not a
  // boolean) so it stays meaningful if the catalog changes to something
  // that isn't Murano glass. Null = badge not shown.
  trustBadgeText         String?
  // Homepage "What customers say" shelf — real reviews only (never
  // fabricated), but some stores launch before they have enough of them to
  // look credible, so admins can hide the section entirely until then.
  showTestimonials       Boolean  @default(true)

  // SEO — Admin > Settings > SEO. All optional with fallbacks applied in
  // src/lib/store-settings.ts and consumed by src/app/layout.tsx,
  // sitemap.ts, and robots.ts.
  siteUrl                String? // canonical base URL, e.g. https://shop.example.com — required for sitemap.xml/robots.txt/canonical links/absolute OG images to resolve correctly once deployed
  metaDescription        String? // falls back to "Shop at {storeName}" if unset
  ogImageUrl             String? // social share preview image (1200x630 recommended); falls back to logoUrl
  googleSiteVerification String? // the "content" value from Search Console's HTML tag verification method

  // Payment provider credentials, editable from Admin > Settings > Payments
  // instead of requiring a redeploy with new env vars. src/lib/stripe.ts and
  // src/lib/paypal.ts check these first, falling back to the env vars of the
  // same name if unset — so either configuration path works.
  stripeSecretKey      String?
  stripePublishableKey String?
  stripeWebhookSecret  String?
  // Off by default: forcing "klarna" into a Checkout Session's
  // payment_method_types when Klarna isn't activated on the Stripe account
  // makes session creation fail outright, so this only takes effect once an
  // admin has confirmed it's active in the Stripe Dashboard and opts in here
  // — see src/app/api/checkout/pay/stripe/route.ts.
  klarnaEnabled        Boolean @default(false)
  paypalClientId       String?
  paypalClientSecret   String?
  paypalWebhookId      String?

  // Same DB-first/env-fallback pattern for the rest of the integrations —
  // Admin > Settings > Integrations.
  resendApiKey         String?
  emailFrom            String?
  turnstileSiteKey     String?
  turnstileSecretKey   String?
  upstashRedisUrl      String?
  upstashRedisToken    String?
  googleClientId       String?
  googleClientSecret   String?

  // Offline payment methods — no gateway needed, so these are plain toggles
  // + the details the customer needs to act on (bank details, COD surcharge)
  // rather than API credentials.
  bankTransferEnabled Boolean @default(false)
  bankAccountHolder   String?
  bankIban            String?
  bankBic             String?
  codEnabled          Boolean @default(false)
  codFee              Int? // cents, added to the order total when COD is chosen

  // Social links, shown in the footer when set — all optional.
  facebookUrl  String?
  instagramUrl String?
  twitterUrl   String?
  tiktokUrl    String?
  youtubeUrl   String?
  linkedinUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Auth (NextAuth / Auth.js v5 — Credentials + optional OAuth via adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String? // null for OAuth-only accounts
  name          String?
  role          String    @default("customer") // customer | staff | admin
  emailVerified DateTime?
  image         String?

  mfaSecret       String? // TOTP secret, set once admin/staff enrolls MFA
  mfaEnabled      Boolean @default(false)
  failedLoginCount Int    @default(0)
  lockedUntil     DateTime?
  // Set whenever the password changes (reset flow). Sessions issued before this
  // moment are rejected — see src/lib/session-refresh.ts.
  passwordChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  addresses      Address[]
  reviews        Review[]
  auditLogs      AuditLog[]
  returnRequests ReturnRequest[]
  consentLogs    ConsentLog[]
  wishlistItems  WishlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  name     String
  // Per-locale display names, shown when the storefront locale matches (see
  // src/lib/product-i18n.ts). Optional and fall back to `name` so catalogs
  // that only ever had one language keep working unchanged.
  nameEn   String?
  nameFr   String?
  nameDe   String?
  nameAr   String?
  nameZh   String?
  nameRu   String?
  nameEs   String?
  namePt   String?
  nameHi   String?
  nameJa   String?
  // Optional page copy shown below the product grid on /category/[slug]: Italian
  // in `description`, then one column per locale, with the same fallback as
  // products (locale -> English -> Italian). See src/lib/product-i18n.ts.
  description   String?
  descriptionEn String?
  descriptionFr String?
  descriptionDe String?
  descriptionAr String?
  descriptionZh String?
  descriptionRu String?
  descriptionEs String?
  descriptionPt String?
  descriptionHi String?
  descriptionJa String?
  slug     String  @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  products Product[]
  taxRules TaxRule[]

  @@index([parentId])
}

model Product {
  id                String   @id @default(cuid())
  name              String
  // Per-locale translations, shown when the storefront locale matches (see
  // src/lib/product-i18n.ts). All optional and fall back to name/description
  // (then to the English fields for fr/de) so products that haven't been
  // translated into every language yet still render correctly.
  nameEn            String?
  nameFr            String?
  nameDe            String?
  nameAr            String?
  nameZh            String?
  nameRu            String?
  nameEs            String?
  namePt            String?
  nameHi            String?
  nameJa            String?
  slug              String   @unique
  description       String
  descriptionEn     String?
  descriptionFr     String?
  descriptionDe     String?
  descriptionAr     String?
  descriptionZh     String?
  descriptionRu     String?
  descriptionEs     String?
  descriptionPt     String?
  descriptionHi     String?
  descriptionJa     String?
  // Persuasive "why this piece" copy shown as its own section on the product
  // page (uniqueness, gift framing, handmade-in-Murano heritage) — separate
  // from `description` above. English-only translation for now, same
  // one-locale-at-a-time rollout as name/description originally had.
  story             String   @default("")
  storyEn           String?
  price             Int // cents, tax-inclusive display price (see StoreSettings.pricesIncludeTax)
  // Display-only "was" price (cents), shown crossed out with a discount badge
  // — never charged. Staff can only set it to at most the lowest price in the
  // 30 days before the current price took effect (EU Omnibus rule, checked
  // against ProductPriceChange in lib/price-history.ts). Shown only while
  // higher than `price`.
  compareAtPrice    Int?
  currency          String   @default("EUR")
  sku               String   @unique
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(5)
  active            Boolean  @default(true)
  // One canonical color per piece, for the filter swatches on /products and
  // /category/[slug] — a fixed small palette (see PRODUCT_COLORS in
  // src/lib/product-colors.ts), not free text, so the filter UI can render
  // real swatches instead of a text dropdown. Optional: an unset color just
  // doesn't match any color filter, it isn't excluded from browsing.
  color             String?

  // Dropshipping: a product sourced from a supplier who ships directly to
  // the customer. trackInventory=false skips the stock check/decrement at
  // checkout entirely (supplier stock isn't ours to track), and costPrice
  // (what we pay the supplier) drives margin reporting — never shown to
  // customers.
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  supplierSku    String?
  costPrice      Int? // cents, what we pay the supplier per unit
  trackInventory Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // The styled set this piece belongs to ("Complete the look" on the product
  // page, bundle discount at checkout — see lib/looks.ts).
  lookId String?
  look   Look?   @relation(fields: [lookId], references: [id], onDelete: SetNull)

  // Gift Finder tagging (Admin > Products), scored by lib/gift-finder.ts —
  // free-form Postgres string arrays rather than a join table since the value
  // sets are small and fixed (see the *_STYLES/OCCASIONS/RECIPIENTS constants
  // there). Untagged products (the default, []) simply score 0 on that
  // criterion instead of being excluded.
  giftStyles     String[] @default([])
  giftOccasions  String[] @default([])
  giftRecipients String[] @default([])

  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  priceChanges  ProductPriceChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([active, createdAt])
  @@index([lookId])
}

// A matching set (necklace + bracelet + earrings) grouped by staff in
// Admin > Looks. Buying all its pieces together takes discountPercent off
// each one, applied server-side in lib/pricing.ts.
model Look {
  id              String   @id @default(cuid())
  name            String
  // Optional styled photo of the pieces together; without it the product
  // page composes the pieces' own photos.
  imageUrl        String?
  discountPercent Int      @default(15)
  active          Boolean  @default(true)
  products        Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Every price a product has had. Written by a database trigger on Product
// (see migration 20260924120000_add_product_price_history), not by app code,
// so admin edits, scripts and raw SQL are all recorded. Backs the Omnibus
// check on compareAtPrice.
model ProductPriceChange {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Int // cents
  changedAt DateTime @default(now())

  @@index([productId, changedAt])
}

// ---------------------------------------------------------------------------
// Dropshipping
// ---------------------------------------------------------------------------

model Supplier {
  id      String  @id @default(cuid())
  name    String
  email   String? // where fulfillment requests get sent
  website String?
  notes   String?
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     Product[]
  fulfillments Fulfillment[]
}

// Groups the order items from one order that belong to one supplier, so a
// multi-supplier order can be routed/tracked per supplier independently.
model Fulfillment {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  status String @default("pending")
  // pending -> sent -> shipped -> delivered

  trackingNumber String?
  sentAt         DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([supplierId])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  altText     String  @default("")
  position    Int     @default(0)
  // On-model/lifestyle photos aren't shot on a plain white background, so the
  // catalog's multiply-blend + edge-feather treatment (src/app/shop.css) reads
  // as a white halo on them. This opts a single image out of that treatment.
  isLifestyle Boolean @default(false)

  @@index([productId, position])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Address {
  id         String  @id @default(cuid())
  userId     String? // null for a guest-checkout address (not saved to any account)
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  street     String
  city       String
  postalCode String
  country    String // ISO 3166-1 alpha-2
  phone      String?
  isDefault  Boolean @default(false)

  // Where the address is on the map, found with OpenStreetMap's geocoder
  // (src/lib/geocode.ts). Filled in shortly after an order is placed, or from the
  // admin order page. geocodedAt is set once a lookup was answered, even with no
  // match (lat/lng stay null then); a lookup that failed leaves it null to retry.
  lat          Float?
  lng          Float?
  geocodedAt   DateTime?
  geocodeLabel String?

  orders Order[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

model ShippingMethod {
  id               String  @id @default(cuid())
  name             String
  basePrice        Int // cents
  pricePerKg       Int     @default(0) // cents
  estimatedDaysMin Int     @default(2)
  estimatedDaysMax Int     @default(5)
  active           Boolean @default(true)

  zoneLinks ShippingZoneMethod[]
  orders    Order[]
}

model ShippingZone {
  id   String @id @default(cuid())
  name String

  countries ShippingZoneCountry[]
  methods   ShippingZoneMethod[]
}

model ShippingZoneCountry {
  id      String       @id @default(cuid())
  zoneId  String
  zone    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  country String // ISO 3166-1 alpha-2

  @@unique([zoneId, country])
  @@index([country])
}

model ShippingZoneMethod {
  id       String         @id @default(cuid())
  zoneId   String
  zone     ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  methodId String
  method   ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)

  @@unique([zoneId, methodId])
  @@index([methodId])
}

// ---------------------------------------------------------------------------
// Tax (VAT/IVA)
// ---------------------------------------------------------------------------

model TaxRule {
  id          String   @id @default(cuid())
  country     String // ISO 3166-1 alpha-2
  region      String?
  ratePercent Float
  name        String // e.g. "IVA standard", "IVA ridotta"
  categoryId  String? // null = applies store-wide for this country/region
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([country])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Orders / payments
// ---------------------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
  guestEmail String? // set when userId is null (guest checkout)

  status String @default("pending")
  // pending -> paid -> processing -> shipped -> delivered
  // pending -> cancelled
  // paid/processing/shipped -> refunded

  subtotal       Int // cents
  taxAmount      Int // cents
  taxRatePercent Float?
  shippingAmount Int // cents
  discountAmount Int    @default(0) // cents, discount code + complete-the-look saving
  // The complete-the-look part of discountAmount (see lib/looks.ts).
  bundleDiscountAmount Int @default(0) // cents
  total          Int // cents
  currency       String @default("EUR")
  // The storefront language the customer checked out in. Emails about the order
  // (status updates, abandoned-cart reminder) are sent from webhooks and cron,
  // with no request to read a language from, so they use this. Null on orders
  // placed before it existed: those get English.
  locale String?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id])
  trackingNumber   String?

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  // Abandoned-order recovery (see src/lib/abandoned-orders.ts): a pending
  // order is the cart at the moment checkout was submitted, so "abandoned
  // cart" = a pending order that never got paid. Set once a reminder email
  // goes out so the cron job doesn't email the same order twice; the order
  // itself is auto-cancelled (and its reserved stock released) after a
  // longer timeout.
  abandonedEmailSentAt DateTime?

  items          OrderItem[]
  payments       Payment[]
  returnRequests ReturnRequest[]
  fulfillments   Fulfillment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([addressId])
  @@index([shippingMethodId])
  @@index([discountCodeId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot at time of purchase
  quantity    Int
  unitPrice   Int // cents, snapshot at time of purchase

  // Dropshipping snapshots — captured at order time so a later change to the
  // product's supplier/cost doesn't rewrite history for past orders.
  supplierId String?
  unitCost   Int? // cents, what we paid the supplier per unit at order time

  fulfillmentId String?
  fulfillment   Fulfillment? @relation(fields: [fulfillmentId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([fulfillmentId])
}

model Payment {
  id                    String  @id @default(cuid())
  orderId               String
  order                 Order   @relation(fields: [orderId], references: [id])
  provider              String // stripe | paypal
  providerTransactionId String? @unique
  status                String  @default("pending") // pending | succeeded | failed | refunded
  amount                Int // cents
  currency              String  @default("EUR")
  createdAt             DateTime @default(now())

  @@index([orderId])
}

model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Float? // 0-100
  amountOff  Int? // cents
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  orders Order[]
}

model ReturnRequest {
  id      String  @id @default(cuid())
  orderId String
  order   Order   @relation(fields: [orderId], references: [id])
  userId  String? // null for a guest order's return request
  user    User?   @relation(fields: [userId], references: [id])
  reason  String
  status  String  @default("requested") // requested | approved | rejected | received | refunded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Compliance / security
// ---------------------------------------------------------------------------

model LegalPage {
  id          String   @id @default(cuid())
  slug        String   @unique // terms | privacy | returns | cookies
  title       String
  content     String
  lastUpdated DateTime @updatedAt
}

model ConsentLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  anonymousId String? // cookie-based id for guests
  consentType String // functional | analytics | marketing
  granted     Boolean
  createdAt   DateTime @default(now())

  @@index([userId])
}

// Marketing email list — deliberately separate from ConsentLog (which is
// per-visit/per-cookie consent, no email address) since this is the actual
// mailing list. Every subscribe still writes a ConsentLog row too
// (consentType "marketing") so there's one consistent audit trail for
// GDPR purposes across both cookie- and email-based marketing consent.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // e.g. "product.update", "order.refund", "settings.update"
  entityType String
  entityId   String?
  beforeData String? // JSON snapshot
  afterData  String? // JSON snapshot
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Internal "what still needs doing" backlog for Admin > Roadmap — staff jot
// down site content/config that needs filling in or revisiting, and it's
// also the one place meant to be read *and written* by an AI coding session
// working on this repo, so ideas/todos survive between sessions instead of
// living only in chat history. Not customer-facing.
model ImprovementTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  priority    String    @default("medium") // low | medium | high
  status      String    @default("open") // open | done
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  // Picked up by the nightly "Roadmap tasks for Claude" routine through
  // api/automation/roadmap/claim; the run writes what it changed and what to
  // check into claudeReport (the "Bacheca" on Admin > Roadmap).
  forClaude       Boolean   @default(false)
  claudeClaimedAt DateTime?
  claudeReport    String?
  claudeReportAt  DateTime?
}
