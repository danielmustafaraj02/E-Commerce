# Copy to .env and fill in real values. Never commit .env with real secrets.

# --- Database ---
# Keep local and production databases SEPARATE:
#  - Local dev: put the values below in .env.local (git-ignored; Next.js and the
#    Prisma CLI both prefer it over .env). Use a local Postgres, e.g.:
#      createdb ecommerce_dev   # then: npx prisma migrate deploy && npm run db:seed
#    DATABASE_URL="postgresql://ecommerce:ecommerce@127.0.0.1:5432/ecommerce_dev"
#  - Production (Vercel/Neon): set DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED
#    in the host's environment settings, never in a committed file. `npm run build`
#    runs `prisma migrate deploy` against it. Previews skip migrations.
#  - Never point a local .env.local at the production database.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth (NextAuth / Auth.js v5) ---
# Generate with: npx auth secret
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Minutes before an admin/staff session forces a fresh login, independent of
# the regular (longer) customer session — see src/proxy.ts. Optional,
# defaults to 240 (4 hours).
ADMIN_SESSION_MAX_AGE_MINUTES="240"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- PayPal ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# --- Email (Resend) ---
RESEND_API_KEY=""
# Sender of every email: must be on a domain verified in Resend, or Resend
# rejects the send. Leave it unset to use "orders@" + RESEND_EMAIL_DOMAIN (set
# by Vercel's Resend integration); with neither, emails are not sent.
EMAIL_FROM=""

# --- Images ---
# No upload pipeline: admins paste an already-hosted image URL (Admin >
# Products). Images served from this site (/products/...), loremflickr.com and
# Vercel Blob are optimized by next/image; images from any other host still
# work but are shown unoptimized. To have another host optimized, list it here
# (comma-separated; `*.cdn.example.com` = one subdomain level) and rebuild.
NEXT_PUBLIC_IMAGE_HOSTS=""
# --- Bot protection (Cloudflare Turnstile) ---
# Without these, CAPTCHA verification is skipped (dormant, not broken).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limiting (Upstash Redis) ---
# Without these, rate limiting falls back to a single-instance in-memory
# limiter — fine for dev, not for a multi-instance production deployment.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Error tracking (optional) ---
# A Sentry (or Sentry-compatible) DSN. Without it, errors are just logged to
# the console/host logs — still fine for small deployments, but you won't
# get alerts. See src/lib/monitoring.ts.
SENTRY_DSN=""

# --- Abandoned-cart recovery / stale order cleanup (src/app/api/cron/abandoned-orders) ---
# A random secret only your cron caller knows. Vercel Cron (see vercel.json)
# sends `Authorization: Bearer $CRON_SECRET` automatically when this env var
# is set — generate one with: openssl rand -hex 32
CRON_SECRET=""
# Hours a pending (unpaid) order waits before a reminder email goes out, and
# before it's auto-cancelled and its reserved stock released. Optional —
# defaults to 1 and 2 (hours).
ABANDONED_ORDER_REMINDER_HOURS="1"
ABANDONED_ORDER_EXPIRE_HOURS="2"
# Bank-transfer orders wait for a wire, so they get a much longer stock hold.
BANK_TRANSFER_HOLD_DAYS="5"

# --- Seed (prisma/seed.ts — local/dev databases only; it refuses NODE_ENV=production) ---
# Password for the seeded admin (12-72 chars). Leave empty to have one generated
# and printed once. There is no built-in default password.
SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_EMAIL="admin@demo-store.example"
# Set to 1 to replace the password of an admin that already exists (e.g. one
# created by an older seed that used a published default).
# SEED_RESET_ADMIN="1"
