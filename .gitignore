# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python cache from one-off scripts/ helpers — never shipped source
__pycache__/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template has no secrets and README tells people to copy it
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (dev.db) — never commit real or seeded customer data
*.db
*.db-journal

# archived originals (e.g. pre-white-background product photos) — local
# backups only, not part of the shipped site
/originals
.env*.local

# private local-only notes — never commit/push (internal ideas/checklists,
# not for public repo visibility)
/PRIVATE_*.md

# Obsidian vault config — purely local editor state, not part of the project
/.obsidian/

# AI tool local configs — may contain local paths or tokens, not for the repo
/.claude/
/.mcp.json
/.agents/
/skills-lock.json

# internal QA/ops reports — working notes, not shipped source
/reports/

# local-only payment/catalog setup helpers — write directly to production
# and prompt for/write live credentials; kept on disk only, never committed
/scripts/setup-payments.ts
/scripts/check-payment-readiness.ts
/scripts/go-live-catalog-update.sh
/scripts/send-test-emails.ts
/scripts/set-stripe-credentials.ts
/scripts/set-paypal-credentials.ts
/scripts/finish-paypal-setup.sh
/scripts/finish-payment-setup.sh
/scripts/link-upstash-kv-vars.ts
.neon
